# Bulk generated scientific payloads. Formal reports and manifests are not
# excluded by these rules and remain eligible for selective tracking.
**/results/
**/outputs/
**/raw_graph_records/
**/graph_records/
**/records/
**/canonical_records/
**/verified_records/
**/training_histories/
**/validation_histories/
**/complete_history/
