      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u5b88\u6052\u578b\u52a8\u6001\u795e\u7ecf\u2013SPH\u6c42\u89e3\u5668\u7684\n\u9a8c\u8bc1\u4f18\u5148\u5f00\u53d1",
      "style": "Normal"
    },
    {
      "para_index": 10,
      "text": "\u4e2d\u6587\u7a3f v0.1  |  Evidence-locked  |  \u975e\u6295\u7a3f\u5b9a\u7a3f",
      "style": "Normal"
    },
    {
      "para_index": 14,
      "text": "\u6458\u8981 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 3",
      "style": "Normal"
    },
    {
      "para_index": 15,
      "text": "\u5173\u952e\u8bcd \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 3",
      "style": "Normal"
    },
    {
      "para_index": 16,
      "text": "1. \u5f15\u8a00 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 3",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "2. \u63a7\u5236\u65b9\u7a0b\u4e0e\u6a21\u578b\u5f62\u5f0f \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 5",
      "style": "Normal"
    },
    {
      "para_index": 18,
      "text": "3. \u9a8c\u8bc1\u4e0e\u8d44\u683c\u6846\u67b6 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 6",
      "style": "Normal"
    },
    {
      "para_index": 19,
      "text": "4. \u52a8\u6001\u53c2\u8003\u8f68\u8ff9 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 8",
      "style": "Normal"
    },
    {
      "para_index": 20,
      "text": "5. \u52a8\u6001\u6c42\u89e3\u5668\u5b9e\u73b0 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 10",
      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "6. \u7ed3\u6784\u9a8c\u8bc1 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 11",
      "style": "Normal"
    },
    {
      "para_index": 22,
      "text": "7. \u591a\u6b65\u53ef\u5fae\u6027\u8d44\u683c \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 12",
      "style": "Normal"
    },
    {
      "para_index": 23,
      "text": "8. \u62d3\u6251\u4e8b\u4ef6\u8d44\u683c \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 15",
      "style": "Normal"
    },
    {
      "para_index": 24,
      "text": "9. \u8ba8\u8bba \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 17",
      "style": "Normal"
    },
    {
      "para_index": 25,
      "text": "10. \u7ed3\u8bba \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 19",
      "style": "Normal"
    },
    {
      "para_index": 26,
      "text": "Data availability \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 19",
      "style": "Normal"
    },
    {
      "para_index": 27,
      "text": "Code availability \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 19",
      "style": "Normal"
    },
    {
      "para_index": 28,
      "text": "Author contributions \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 \u00b7 19",
      "style": "Normal"
